# LLM Configuration (Anthropic Claude or Mock for local/offline testing)
LLM_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_TEMPERATURE=0
LLM_PROVIDER=auto

# Embeddings & Vector Database
EMBEDDING_MODEL=BAAI/bge-small-en
EMBEDDING_PROVIDER=fastembed
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma

# Database Configuration (Supabase PostgreSQL or SQLite for zero-setup local dev)
DATABASE_URL=sqlite:///./data/lead_agent.db
SUPABASE_URL=
SUPABASE_KEY=

# Application & Decision Gate Parameters
CONFIDENCE_THRESHOLD=0.75
UPLOAD_MAX_SIZE_MB=25
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

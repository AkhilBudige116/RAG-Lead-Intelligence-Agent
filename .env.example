# ==============================================================================
# RAG Lead Intelligence Agent - Environment Configuration
# ==============================================================================

# Application Environment ('development' for local SQLite, 'production' for Vercel/Supabase)
ENVIRONMENT=production

# Database Configuration
# Local dev: sqlite:///./data/lead_agent.db
# Production: Supabase PostgreSQL connection string (Transaction pooler or direct)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[HOST]:[PORT]/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]

# Vector Store ('chroma' for local dev, 'pgvector' or 'supabase' for production)
VECTOR_STORE=pgvector
CHROMA_PERSIST_DIR=/tmp/chroma

# Embeddings Configuration
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en
FASTEMBED_CACHE_PATH=/tmp/model_cache

# LLM Configuration (Anthropic Claude API or 'auto' for deterministic fallback)
LLM_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_TEMPERATURE=0
LLM_PROVIDER=auto

# Application & Decision Gate Parameters
CONFIDENCE_THRESHOLD=0.75
REVIEW_THRESHOLD_MIN=0.50
UPLOAD_MAX_SIZE_MB=25
PORT=8000
CORS_ORIGINS=["*"]

